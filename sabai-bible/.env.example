# ──────────────────────────────────────────────────────────────
# Bible Journey Map app URL (the iframe embed — Project 2 on Vercel)
# Set this after deploying the root app, then redeploy sabai-bible
# ──────────────────────────────────────────────────────────────
VITE_BIBLE_MAP_URL="https://YOUR-BIBLE-MAP-PROJECT.vercel.app"

# ──────────────────────────────────────────────────────────────
# Supabase (optional — journey/verse data; falls back to mock data)
# ──────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ──────────────────────────────────────────────────────────────
# Gemini AI (optional – injected automatically by AI Studio)
# ──────────────────────────────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ──────────────────────────────────────────────────────────────
# App URL (set automatically by Vercel at runtime)
# ──────────────────────────────────────────────────────────────
APP_URL="MY_APP_URL"
